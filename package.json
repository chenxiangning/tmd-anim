{
  "name": "tmd-anim",
  "version": "0.1.4",
  "description": "Technical animation video studio. Scene JSON in, deterministic video out.",
  "author": "Chen Xiangning",
  "homepage": "https://github.com/chenxiangning/tmd-anim#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenxiangning/tmd-anim.git"
  },
  "bugs": {
    "url": "https://github.com/chenxiangning/tmd-anim/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.15.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:player": "node scripts/build-player.mjs",
    "build": "pnpm build:player && tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:file-size": "node scripts/check-file-size.mjs",
    "check": "pnpm build:player && pnpm check:file-size && pnpm typecheck && pnpm test && pnpm build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/re-local.mjs",
    "anim": "tsx scripts/anim.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.7.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "mediabunny": "^1.61.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.2"
  }
}
