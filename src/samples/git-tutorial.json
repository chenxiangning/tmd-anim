    {
      "id": "sc-add",
      "name": "2. 第一步:git add",
      "dwell": 4,
      "caption": "第一步 git add:把改动的文件放进「待保存」清单。",
      "elements": [
        {
          "kind": "stepCard",
          "id": "f1",
          "num": "1",
          "title": "git add",
          "desc": "把改动文件放进暂存区,相当于勾选「要保存这些」",
          "highlight": [
            "暂存区"
          ],
          "accent": "#3B82F6",
          "x": 160,
          "y": 220,
          "w": 560,
          "anim": {
            "type": "slideLeft",
            "start": 0.2,
            "duration": 0.7
          }
        },
        {
          "kind": "terminal",
          "id": "f2",
          "title": "terminal",
          "code": "$ echo \"我的第一行代码\" > app.js\n$ git add app.js\n$ git status\n  changes to be committed:\n    new file:  app.js",
          "dark": true,
          "x": 800,
          "y": 200,
          "w": 960,
          "h": 420,
          "anim": {
            "type": "typewriter",
            "start": 1.0,
            "duration": 2
          }
        },
        {
          "kind": "note",
          "id": "f3",
          "text": "add 只是登记,还没真正保存!",
