{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tmd-anim",
  "version": "0.1.0",
  "identifier": "com.tmdanim.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1431",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "tmd-anim · 技术动画制作",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
